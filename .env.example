# Токен от @BotFather. Вставьте только значение, без кавычек.
BOT_TOKEN=

# Необязательно: прокси для доступа к api.telegram.org.
# Примеры: http://127.0.0.1:8080, socks5://127.0.0.1:1080
# MTProto-прокси Telegram Desktop (TgWsProxy) сюда не подходит.
BOT_PROXY=

# Максимальный размер .docx (Telegram всё равно ограничивает 20 МБ).
MAX_FILE_MB=20

# Защита от спама: сколько проверок разрешено одному пользователю за окно.
RATE_LIMIT_CHECKS=8
RATE_LIMIT_WINDOW_SEC=600

# Сколько нарушений хранить в отчёте (остальные будут отброшены с пометкой).
MAX_REPORT_ISSUES=1000

LOG_LEVEL=INFO
